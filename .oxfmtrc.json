{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortPackageJson": false,
  "sortImports": {
    "newlinesBetween": false
  },
  "ignorePatterns": [
    "**/node_modules",
    "**/dist",
    "**/.turbo",
    "**/coverage",
    "**/.next",
    "**/build",
    "**/out",
    "**/*.md"
  ]
}
